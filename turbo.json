{
  "$schema": "https://v2-9-1.turborepo.dev/schema.json",
  "globalDependencies": [
    ".oxfmtrc.json",
    "tsconfig.base.json",
    "tsconfig.packages.build.json",
    "tsconfig.packages.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build"]
    },
    "test:dev": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": []
    },
    "test:dev:quiet": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": []
    }
  },
  "remoteCache": {
    "enabled": false
  }
}
