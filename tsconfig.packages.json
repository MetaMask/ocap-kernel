{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    /**
     * Here we ensure that TypeScript resolves `@ocap/*` imports to the
     * uncompiled source code for packages that live in this repo.
     */
    "paths": {
      "@metamask/*": ["./packages/*/src"],
      "@ocap/kernel-language-model-service/open-v1/nodejs": [
        "./packages/kernel-language-model-service/src/open-v1/nodejs.ts"
      ],
      "@metamask/kernel-store/sqlite/nodejs": [
        "./packages/kernel-store/src/sqlite/nodejs.ts"
      ],
      "@metamask/kernel-store/sqlite/wasm": [
        "./packages/kernel-store/src/sqlite/wasm.ts"
      ],
      "@ocap/*": ["./packages/*/src"]
    }
  }
}
